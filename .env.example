QEV_API_KEY=your_quickemailverification_api_key
QEV_API_URL=https://api.quickemailverification.com/v1/verify

# Google Sheet (optional; leave blank to skip). Use ONE of these:
#  a) Paste sheets_webhook.gs into the sheet (Extensions > Apps Script), deploy it
#     as a web app, and put the deployment URL here. It ends in /exec, e.g.
#     https://script.google.com/macros/s/<deployment-id>/exec
#     (not the spreadsheet's own docs.google.com/.../edit link).
GOOGLE_SHEETS_WEBAPP_URL=
#  b) Or set the spreadsheet ID plus an OAuth access token with spreadsheets scope.
#     The ID is only the part between /d/ and /edit in the sheet URL.
GOOGLE_SHEET_ID=
GOOGLE_ACCESS_TOKEN=

# Slack: incoming webhook, or a bot token that can post to the channel.
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
# Channel for bot-token posts (right-click the channel > Copy link; the ID starts with C).
# Leave commented out to use the default channel set in verify_email.py.
# SLACK_CHANNEL_ID=C0123456789

# Salesforce REST (not the Hosted MCP consumer key — that only has mcp_api).
# Create a second External Client App with scope "Manage user data via APIs (api)".
# Developer Edition login: https://login.salesforce.com
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Client credentials flow (preferred): enable it on the app and leave user/pass blank.
# Password flow: username + password + security token from Reset My Security Token.
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
# Optional: paste a session if you already have one (sf org display).
SF_ACCESS_TOKEN=
SF_INSTANCE_URL=

# Gmail IMAP (Google Account → Security → 2-Step Verification → App passwords).
# Use the 16-character app password, not your normal Gmail password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_PROCESSED_LABEL=EmailVerified
GMAIL_POLL_SECONDS=60
