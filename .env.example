QEV_API_KEY=your_quickemailverification_api_key
QEV_API_URL=https://api.quickemailverification.com/v1/verify

# Google Sheet: set the spreadsheet ID from the sheet URL, then either
# paste sheets_webhook.gs into Extensions > Apps Script and deploy it, or
# provide a Google OAuth access token with spreadsheets scope.
GOOGLE_SHEET_ID=1cVKYLeD6GC-d0Xj-f96xYNxfMqSMxhtImovzjSKOuKw/edit?gid=0#gid=0
GOOGLE_SHEETS_WEBAPP_URL=https://docs.google.com/spreadsheets/d/1cVKYLeD6GC-d0Xj-f96xYNxfMqSMxhtImovzjSKOuKw/edit?gid=0#gid=0
GOOGLE_ACCESS_TOKEN=

# Slack: incoming webhook, or a bot token that can post to the channel.
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=C02RANF29DX

# Salesforce REST (not the Hosted MCP consumer key — that only has mcp_api).
# Create a second External Client App with scope "Manage user data via APIs (api)".
# Developer Edition login: https://login.salesforce.com
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Client credentials flow (preferred): enable it on the app and leave user/pass blank.
# Password flow: username + password + security token from Reset My Security Token.
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
# Optional: paste a session if you already have one (sf org display).
SF_ACCESS_TOKEN=
SF_INSTANCE_URL=

# Gmail IMAP (Google Account → Security → 2-Step Verification → App passwords).
# Use the 16-character app password, not your normal Gmail password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_PROCESSED_LABEL=EmailVerified
GMAIL_POLL_SECONDS=60
